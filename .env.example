# Postgres connection string. Supabase: use the Transaction pooler URL (port 6543).
# The Vercel Supabase/Neon integrations set POSTGRES_URL / DATABASE_URL automatically.
# Optional: without it the site scrapes on demand and caches for 6 h on Vercel,
# and locally uses .data/opportunities.json.
DATABASE_URL=

# Random secret. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
